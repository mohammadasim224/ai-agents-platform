OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/free

# Per-role models. Each must be a valid OpenRouter model ID.
MANAGER_MODEL=openrouter/free
MARKETING_MODEL=openrouter/free
SALES_MODEL=openrouter/free
AUTOMATION_MODEL=openrouter/free
EVALUATION_MODEL=openrouter/free

PROJECT_NAME=AI Business Team
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# ---------------------------------------------------------------
# Pipeline reliability
# ---------------------------------------------------------------
# Retries for transient provider failures.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1.5
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4000

# Shortest acceptable specialist deliverable, in characters. Shorter output is
# rejected as incomplete rather than passed upward.
MIN_DELIVERABLE_CHARS=120

# ---------------------------------------------------------------
# Sales script backtest quality gate
# ---------------------------------------------------------------
# A sales script is rejected unless it reaches the target conversion rate over at
# least the minimum number of simulated calls. Conversion is judged by an
# independent scoring agent.
BACKTEST_MIN_CALLS=20
BACKTEST_TARGET_CONVERSION=0.5
BACKTEST_MAX_CALLS=40
BACKTEST_BATCH_SIZE=4
BACKTEST_MAX_ROUNDS=5
